{
  "ci": {
    "collect": {
      "startServerCommand": "bun run preview --host 127.0.0.1",
      "startServerReadyPattern": "127.0.0.1:4173",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://127.0.0.1:4173/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638,
          "requestLatencyMs": 562.5,
          "downloadThroughputKbps": 1638,
          "uploadThroughputKbps": 750,
          "cpuSlowdownMultiplier": 4
        },
        "screenEmulation": {
          "mobile": true,
          "width": 375,
          "height": 812,
          "deviceScaleFactor": 2,
          "disabled": false
        },
        "onlyCategories": [
          "performance"
        ],
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 300
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
