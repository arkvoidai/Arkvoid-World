    "esbuild": "^0.28.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "3.4.17",
